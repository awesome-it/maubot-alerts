{%- set color_title = "#2e7d32" -%}
{%- set color_secondary = "#999999" -%}
{%- if alertgroup.status == "firing" -%}
    {%- set color_title = "#d32f2f" -%}
{%- elif alertgroup.status == "acknowledged" -%}
    {%- set color_title = "#ed6c02" -%}
{%- endif -%}
{%- if alertgroup.last_actor -%}
    {%- set actor_annotation = " by " + alertgroup.last_actor -%}
{%- else -%}
    {%- set actor_annotation = "" -%}
{%- endif -%}
{% set grafana_alerts_url = "https://monitoring.awesome-it.de/"
                            ~ "alerting/groups?groupBy=alertname,instance"
                            ~ "&alertState=active"
                            ~ "&queryString=alertname%3D"
                            ~ alertgroup.group_labels.get("alertname", "Alert") %}
<strong>
<span data-mx-color="{{ color_title }}">
{%- if alertgroup.status == "firing" %}🔥 {% elif alertgroup.status == "acknowledged" %}👍️ {% else %}✅ {% endif -%}
    {{ alertgroup.status | upper }}{{ actor_annotation }}:
</span>
    <a href='{{ grafana_alerts_url }}'>{{ alertgroup.group_labels.get("alertname", "Alert") }}</a>&nbsp;
    Total firing alerts ({{ alertgroup.total_firing_alerts }}):
</strong>
{%- if alertgroup.notification_reason %}
    &nbsp;<span data-mx-color="{{ color_secondary }}">{{ alertgroup.notification_reason }}{% if alertgroup.updated_at %} at {{ alertgroup.updated_at.strftime("%Y-%m-%d %H:%M:%S %Z") }}{% endif %}</span>
    <br/>
{%- endif %}
{%- if alertgroup.common_annotations.get("summary") %}
    {{ alertgroup.common_annotations["summary"] }}<br />
{%- endif %}
{%- if alertgroup.group_labels %}
    <blockquote>
    {% for key, value in alertgroup.group_labels.items() -%}
        {%- set c = key | label_color -%}
        <code><b><span data-mx-color="{{ c.bg }}">{{ key }}</span></b>: {{ value }}</code>{% if not loop.last %}, {% endif %}
    {%- endfor %}
    </blockquote>
{%- endif %}
{%- if alertgroup.firing_alerts %}
    <ul>
        <li>
            <b>Firing Alerts ({{ alertgroup.firing_alerts|length }}):</b>
            <ul>
                {%- for alert in alertgroup.firing_alerts %}
                    <li>{{ alert.message }}</li>
                {%- endfor %}
            </ul>
        </li>
    </ul>
{%- endif %}
{%- if alertgroup.resolved_alerts %}
    <ul>
        <li>
            <b>Resolved Alerts ({{ alertgroup.resolved_alerts|length }}):</b>
            <ul>
                {%- for alert in alertgroup.resolved_alerts %}
                    <li>{{ alert.message }}</li>
                {%- endfor %}
            </ul>
        </li>
    </ul>
{%- endif %}