{%- set color = "green" %}
{%- if status == "firing" %}
{%- set color = "red" %}
{%- elif status == "acknowledged" %}
{%- set color = "orange" %}
{%- endif %}
{% if last_actor %}
{%- set actor_annotation = "by " + last_actor %}
{%- else %}
{%- set actor_annotation = "" %}
{%- endif %}
<strong><font color={{ color }}>{{ status | upper }}{{ actor_annotation }}: </font></strong>
<a href='{{ data['generatorURL'] }}'>{{ data['labels']['alertname'] }}</a><br/>
{{ data['annotations']['description'] }}<br/>
Labels: {% for key, value in data['labels'] | dictsort %}<strong>{{ key }}:</strong> {{ value }}<br/>{% endfor %}
